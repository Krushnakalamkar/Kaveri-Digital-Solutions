{
  "extends": "../../tsconfig.base.json",
  "include": ["next-env.d.ts", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "src/**/*"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts", "src/App.tsx", "src/main.tsx", "src/pages/**/*", "src/components/ui/**/*", "src/components/error-boundary.tsx"],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [{ "name": "next" }]
  }
}
